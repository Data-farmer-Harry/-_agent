{
  "enabled": true,
  "fast_max_score": 34,
  "balanced_max_score": 69,
  "fallback_on_error": true,
  "max_escalations": 1,
  "strict_model_capabilities": true,
  "routes": {
    "fast": {
      "api_base_url": "https://api.deepseek.com",
      "api_key_env": "PHASE_DIAGRAM_LLM_API_KEY",
      "model": "deepseek-v4-flash",
      "timeout_seconds": 45,
      "max_tokens": 1200,
      "temperature": 0.1,
      "enable_thinking": false,
      "capabilities": ["text", "structured_output"],
      "capabilities_verified": true,
      "context_window_tokens": 64000,
      "latency_class": "low",
      "cost_class": "low"
    },
    "balanced": {
      "capabilities": ["text", "structured_output", "code", "reasoning"],
      "capabilities_verified": false,
      "context_window_tokens": 64000,
      "latency_class": "standard",
      "cost_class": "standard"
    },
    "strong": {
      "capabilities": ["text", "structured_output", "code", "reasoning"],
      "capabilities_verified": false,
      "context_window_tokens": 64000,
      "latency_class": "high",
      "cost_class": "high"
    },
    "vision": {
      "capabilities": ["text", "structured_output", "vision"],
      "capabilities_verified": false,
      "context_window_tokens": 64000,
      "latency_class": "high",
      "cost_class": "high"
    }
  },
  "fallbacks": {
    "fast": "balanced",
    "balanced": "strong",
    "strong": "",
    "vision": "strong"
  },
  "learned_policy": {
    "enabled": true,
    "mode": "guarded",
    "model_path": "backend/models/llm_route_mlp/model.json",
    "confidence_threshold": 0.72,
    "min_probability_margin": 0.16,
    "max_normalized_entropy": 0.72,
    "reject_ood": true,
    "allow_downgrade": true,
    "notes": [
      "Run `conda run -n lammps_agent python backend/benchmarks/train_llm_route_mlp.py` to retrain the local MLP model.",
      "Guarded mode applies only recommendations above confidence_threshold.",
      "Capability floors still prevent scientific code, repair, review, and vision tasks from being downgraded unsafely."
    ]
  },
  "capability_min_tiers": {
    "memory": "fast",
    "prompt": "fast",
    "query": "balanced",
    "rewrite": "balanced",
    "rag": "balanced",
    "literature": "balanced",
    "supervisor": "balanced",
    "phase": "strong",
    "thermo": "strong",
    "codegen": "strong",
    "repair": "strong",
    "review": "strong",
    "judge": "strong",
    "lammps": "strong",
    "vision": "vision",
    "recognition": "vision",
    "multimodal": "vision"
  },
  "notes": [
    "Copy this file to backend/configs/llm_routing.json to enable local overrides.",
    "Do not place real API keys in this JSON. Keep keys in backend/.env, backend/configs/.env, process env, or your secret manager.",
    "The fast tier uses the official DeepSeek `deepseek-v4-flash` id; balanced/strong/vision inherit the central LLM config unless explicitly added here.",
    "When this file is absent, all tiers safely inherit backend/configs/llm_config.json and the current PHASE_DIAGRAM_LLM_* settings."
  ]
}
